    [ @file = "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc"; @line = 347; @symbol_functiondef = [arLore,347,13,19]; @symbol_param<0> = [i,347,20,21]; ]
    function arLore(i) {
_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_347_23_360_4_start:
[ "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc" 348 8 ]
        [ "_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_347_23_360_4_start" "_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_347_23_360_4_stop" ]
        %a.1 = local;
        symbol [ a %a.1 348 12 13 ];
        %tmp.1 = newa 9;
        %tmp.2 = "Green dark, loud with birds. Something stone-faced watches the path.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "A crack behind the waterfall, then a room that answers your voice.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "The ground is warm through your boots. The summit smokes politely.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "Cold water falling into a pool nobody has swum in for centuries.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "Streets under the leaf litter. This island was somebody's kingdom.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "A shelf of living colour, two fathoms down and worth the swim.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "Above the clouds the air tastes of lightning. Nothing grows here.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Roofs under the waves. The tide keeps the front doors shut.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "A seam of open sky that hums. Compasses point at it, not north.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        lputv %a.1 %tmp.28;
        symbol [ a %a.1 348 12 13 ];
[ "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc" 359 8 ]
        %tmp.29 = lgetv %a.1;
        symbol [ a %tmp.29 359 15 16 ];
