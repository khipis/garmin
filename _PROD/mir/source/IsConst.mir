    [ @file = "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc"; @line = 396; @symbol_functiondef = [cLore,396,13,18]; @symbol_param<0> = [i,396,19,20]; ]
    function cLore(i) {
_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_396_22_415_4_start:
[ "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc" 397 8 ]
        [ "_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_396_22_415_4_start" "_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_396_22_415_4_stop" ]
        %a.1 = local;
        symbol [ a %a.1 397 12 13 ];
        %tmp.1 = newa 15;
        %tmp.2 = "Nine palms in a ring. Shade at noon, coconuts by evening.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Every shell on this beach, sorted by the patient and the small.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "A guardian face cut in soft wood. The village sleeps better.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "Its leaves really are gold. It refuses to say how.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "A garden of living stone that repaints itself every season.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "It falls in slow blue crystal instead of water, and it never runs dry.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "Carved before anyone counted years. Still facing the sunrise.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Raised by the old kingdom to mark something they never wrote down.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "Seven colours in the spray, all day, in any weather.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        %tmp.29 = "Pearls in a circle of white gold. Fit for whoever owns this island.";
        %tmp.30 = dup %tmp.28;
        %tmp.31 = aputv %tmp.30 9 %tmp.29;
        %tmp.32 = "Rung once on the peak. Storms are said to change their minds.";
        %tmp.33 = dup %tmp.31;
        %tmp.34 = aputv %tmp.33 10 %tmp.32;
        %tmp.35 = "Salvaged from a drowned hall. It is warm and nobody knows why.";
        %tmp.36 = dup %tmp.34;
        %tmp.37 = aputv %tmp.36 11 %tmp.35;
        %tmp.38 = "A splinter of the sky seam. Light bends around it politely.";
        %tmp.39 = dup %tmp.37;
        %tmp.40 = aputv %tmp.39 12 %tmp.38;
        %tmp.41 = "A pearl the size of a fist, from an oyster nobody has seen.";
        %tmp.42 = dup %tmp.40;
        %tmp.43 = aputv %tmp.42 13 %tmp.41;
        %tmp.44 = "A flower that will not close. The island grew it as a thank you.";
        %tmp.45 = dup %tmp.43;
        %tmp.46 = aputv %tmp.45 14 %tmp.44;
        lputv %a.1 %tmp.46;
        symbol [ a %a.1 397 12 13 ];
[ "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc" 414 8 ]
