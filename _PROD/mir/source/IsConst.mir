    [ @file = "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc"; @line = 228; @symbol_functiondef = [bLore,228,13,18]; @symbol_param<0> = [i,228,19,20]; ]
    function bLore(i) {
_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_228_22_254_4_start:
[ "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc" 229 8 ]
        [ "_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_228_22_254_4_start" "_Users_kkorolczuk_work_garmin_island_source_IsConst_mc_228_22_254_4_stop" ]
        %a.1 = local;
        symbol [ a %a.1 229 12 13 ];
        %tmp.1 = newa 22;
        %tmp.2 = "Canvas, rope and hope. Every island paradise started under one.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Four walls and a warm window. People stay once there is a door.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Wide verandas and sea views. Guests arrive and forget to leave.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "Stone that outlives its builders. The island finally has a skyline.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "Planted young, felled slowly. The grove pays for the whole village.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "Neat beds of sweet roots. Full bellies grow into more neighbours.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "Trade boats put in at the still water. Coin follows the current.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Switchbacks cut into the ridge. The mountain gives up its stone.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "Soft sand raked every morning. Visitors pay simply to lie on it.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        %tmp.29 = "Sand and cheering. The island discovers it enjoys a crowd.";
        %tmp.30 = dup %tmp.28;
        %tmp.31 = aputv %tmp.30 9 %tmp.29;
        %tmp.32 = "Lanterns strung between the palms. Nobody sleeps on festival week.";
        %tmp.33 = dup %tmp.31;
        %tmp.34 = aputv %tmp.33 10 %tmp.32;
        %tmp.35 = "Marble, shade and cold drinks. Wealthy guests bring wealthy friends.";
        %tmp.36 = dup %tmp.34;
        %tmp.37 = aputv %tmp.36 11 %tmp.35;
        %tmp.38 = "Older than the jungle around it. The steps were carved for someone.";
        %tmp.39 = dup %tmp.37;
        %tmp.40 = aputv %tmp.39 12 %tmp.38;
        %tmp.41 = "It hums at dawn and the whole island works a little faster.";
        %tmp.42 = dup %tmp.40;
        %tmp.43 = aputv %tmp.42 13 %tmp.41;
        %tmp.44 = "Carved from one red boulder. Sailors change course to see it.";
        %tmp.45 = dup %tmp.43;
        %tmp.46 = aputv %tmp.45 14 %tmp.44;
        %tmp.47 = "It should not float, and it does. The clouds arrange themselves.";
        %tmp.48 = dup %tmp.46;
        %tmp.49 = aputv %tmp.48 15 %tmp.47;
        %tmp.50 = "A spire of glass homes. The lift takes a full minute to climb.";
        %tmp.51 = dup %tmp.49;
        %tmp.52 = aputv %tmp.51 16 %tmp.50;
        %tmp.53 = "The saw never stops. Timber leaves faster than the forest grows.";
        %tmp.54 = dup %tmp.52;
        %tmp.55 = aputv %tmp.54 17 %tmp.53;
        %tmp.56 = "Deep-water berths for long white boats. Harbour fees do the rest.";
        %tmp.57 = dup %tmp.55;
        %tmp.58 = aputv %tmp.57 18 %tmp.56;
        %tmp.59 = "It drinks the sunrise and the quarry works twice as hard.";
        %tmp.60 = dup %tmp.58;
        %tmp.61 = aputv %tmp.60 19 %tmp.59;
        %tmp.62 = "Raised from the drowned city, still wet, still counting its treasure.";
        %tmp.63 = dup %tmp.61;
        %tmp.64 = aputv %tmp.63 20 %tmp.62;
        %tmp.65 = "A tear in the sky, held open. Wealth arrives from somewhere else.";
        %tmp.66 = dup %tmp.64;
        %tmp.67 = aputv %tmp.66 21 %tmp.65;
        lputv %a.1 %tmp.67;
        symbol [ a %a.1 229 12 13 ];
[ "/Users/kkorolczuk/work/garmin/island/source/IsConst.mc" 253 8 ]
