        %a.1 = local;
        symbol [ a %a.1 273 12 13 ];
        %tmp.1 = newa 9;
        %tmp.2 = "Iron sand to the horizon. The rovers came back orange and loaded.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "A valley that never thaws. Our lamps threw blue shadows.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Spires taller than the mast, ringing softly when the wind turns.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "Growth that leans toward the lamps and closes when we walk away.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "Cut stone, sealed doors, and a stair built for something taller.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "Lightning walks the basin all day. The magma below never cools.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "Galleries under galleries. The survey drones ran out of power.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "A frozen sea clear to the seabed. Nothing moves down there.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "The planet has a heartbeat, and at this depth you can hear it.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        lputv %a.1 %tmp.28;
        symbol [ a %a.1 273 12 13 ];
