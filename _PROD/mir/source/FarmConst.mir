    [ @file = "/Users/kkorolczuk/work/garmin/farm/source/FarmConst.mc"; @line = 401; @symbol_functiondef = [cLore,401,13,18]; @symbol_param<0> = [i,401,19,20]; ]
    function cLore(i) {
_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_401_22_420_4_start:
[ "/Users/kkorolczuk/work/garmin/farm/source/FarmConst.mc" 402 8 ]
        [ "_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_401_22_420_4_start" "_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_401_22_420_4_stop" ]
        %a.1 = local;
        symbol [ a %a.1 402 12 13 ];
        %tmp.1 = newa 15;
        %tmp.2 = "Planted the spring the farm opened. It never needed any help.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Stuffed with last year's straw. The crows respect him, mostly.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Stacked by hand at dusk. Cats sleep on top, all of them at once.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "One hen, one morning, one egg that would not crack. Never sold.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "They arrived on their own and stayed. The pond is theirs now.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "She was born after a storm with a coat nobody can explain.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "The bucket still comes up cold. Visitors throw in coins and hope.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "First place at the county fair. The nail it hangs on came with it.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "Long table, short speeches, everything on it grown right here.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        %tmp.29 = "The bees moved in uninvited and doubled the orchard that year.";
        %tmp.30 = dup %tmp.28;
        %tmp.31 = aputv %tmp.30 9 %tmp.29;
        %tmp.32 = "Older than the farm. The mason's initials are still under the moss.";
        %tmp.33 = dup %tmp.31;
        %tmp.34 = aputv %tmp.33 10 %tmp.32;
        %tmp.35 = "Found lit in the marsh with nobody near it. It has not gone out.";
        %tmp.36 = dup %tmp.34;
        %tmp.37 = aputv %tmp.36 11 %tmp.35;
        %tmp.38 = "Woven at midsummer from the tallest sunflowers in the whole vale.";
        %tmp.39 = dup %tmp.37;
        %tmp.40 = aputv %tmp.39 12 %tmp.38;
        %tmp.41 = "It rolls without a horse on full moons. Nobody rides it twice.";
        %tmp.42 = dup %tmp.40;
        %tmp.43 = aputv %tmp.42 13 %tmp.41;
        %tmp.44 = "Turns ground that grew nothing into a field before breakfast.";
        %tmp.45 = dup %tmp.43;
        %tmp.46 = aputv %tmp.45 14 %tmp.44;
        lputv %a.1 %tmp.46;
        symbol [ a %a.1 402 12 13 ];
[ "/Users/kkorolczuk/work/garmin/farm/source/FarmConst.mc" 419 8 ]
