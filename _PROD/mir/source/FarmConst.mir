        %a.1 = local;
        symbol [ a %a.1 336 12 13 ];
        %tmp.1 = newa 9;
        %tmp.2 = "Waist-high grass and bees. Walk it once and the paths appear.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Old timber, soft light, and a stump wide enough to eat lunch on.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Still water at the bottom of the paddock, warmer than it should be.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "A long climb for a short view, and the view is worth every step.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "The roof is gone but the hearth is intact. Somebody farmed here.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "A whole valley facing south, yellow ridge to ridge by August.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "The press has not turned in years. The apples kept growing anyway.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Reeds, mist, and one steady light that nobody can walk up to.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "The highest ground you own. On clear nights the moon sits on it.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        lputv %a.1 %tmp.28;
        symbol [ a %a.1 336 12 13 ];
