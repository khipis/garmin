        %tmp.77 = invoke %tmp.69 %tmp.70(%tmp.71, %tmp.72, %tmp.76);
        %tmp.78 = agetv %tmp.68 %tmp.77;
        ret %tmp.78;
_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_172_22_198_4_stop:
    }
