    [ @file = "/Users/kkorolczuk/work/garmin/farm/source/FarmConst.mc"; @line = 172; @symbol_functiondef = [bLore,172,13,18]; @symbol_param<0> = [i,172,19,20]; ]
    function bLore(i) {
_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_172_22_198_4_start:
[ "/Users/kkorolczuk/work/garmin/farm/source/FarmConst.mc" 173 8 ]
        [ "_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_172_22_198_4_start" "_Users_kkorolczuk_work_garmin_farm_source_FarmConst_mc_172_22_198_4_stop" ]
        %a.1 = local;
        symbol [ a %a.1 173 12 13 ];
        %tmp.1 = newa 22;
        %tmp.2 = "A crooked little coop. The hens were here before the fence was.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Rain filled a hollow and the ducks moved in the same afternoon.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Mud, straw and contentment. They out-eat everything else you own.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "Warm, dim and smelling of hay. The heart of any working farm.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "Gold to the fence line. It bends in the wind like slow water.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "Neat green tufts hiding sweet roots. The animals know where.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "Grandmother planted the first row. You still prune it her way.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Thorny, generous, and always picked over by somebody's children.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "A plank, a scale and an honesty box. Half the valley stops here.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        %tmp.29 = "Its sails turned through four owners and never missed a harvest.";
        %tmp.30 = dup %tmp.28;
        %tmp.31 = aputv %tmp.30 9 %tmp.29;
        %tmp.32 = "The smell reaches the road. That is the entire marketing plan.";
        %tmp.33 = dup %tmp.31;
        %tmp.34 = aputv %tmp.33 10 %tmp.32;
        %tmp.35 = "Small hands, patient animals, and a queue every single weekend.";
        %tmp.36 = dup %tmp.34;
        %tmp.37 = aputv %tmp.36 11 %tmp.35;
        %tmp.38 = "Painted the colour of a good year. Visitors photograph it first.";
        %tmp.39 = dup %tmp.37;
        %tmp.40 = aputv %tmp.39 12 %tmp.38;
        %tmp.41 = "Warm glass and green light. Everything outside grows faster too.";
        %tmp.42 = dup %tmp.40;
        %tmp.43 = aputv %tmp.42 13 %tmp.41;
        %tmp.44 = "Champion three shows running. He knows it, and he poses.";
        %tmp.45 = dup %tmp.43;
        %tmp.46 = aputv %tmp.45 14 %tmp.44;
        %tmp.47 = "Painted by the whole village one summer. It stores more than grain.";
        %tmp.48 = dup %tmp.46;
        %tmp.49 = aputv %tmp.48 15 %tmp.47;
        %tmp.50 = "Curious, woolly, faintly disapproving. The children adore them.";
        %tmp.51 = dup %tmp.49;
        %tmp.52 = aputv %tmp.51 16 %tmp.50;
        %tmp.53 = "A field of faces that follow the sun and feed the whole herd.";
        %tmp.54 = dup %tmp.52;
        %tmp.55 = aputv %tmp.54 17 %tmp.53;
        %tmp.56 = "Cold rooms, copper churns, and butter with a waiting list.";
        %tmp.57 = dup %tmp.55;
        %tmp.58 = aputv %tmp.57 18 %tmp.56;
        %tmp.59 = "The old press wakes each autumn and the yard smells of apples.";
        %tmp.60 = dup %tmp.58;
        %tmp.61 = aputv %tmp.60 19 %tmp.59;
        %tmp.62 = "Silver boards that glow after dusk. The animals sleep better here.";
        %tmp.63 = dup %tmp.61;
        %tmp.64 = aputv %tmp.63 20 %tmp.62;
        %tmp.65 = "It hangs low over the ridge and refuses to set. Everything ripens.";
        %tmp.66 = dup %tmp.64;
        %tmp.67 = aputv %tmp.66 21 %tmp.65;
        lputv %a.1 %tmp.67;
        symbol [ a %a.1 173 12 13 ];
[ "/Users/kkorolczuk/work/garmin/farm/source/FarmConst.mc" 197 8 ]
        %tmp.68 = lgetv %a.1;
        symbol [ a %tmp.68 197 15 16 ];
        %tmp.69 = self;
        symbol [ _c %tmp.70 197 17 19 ];
        %tmp.70 = getv function %tmp.69 :_c;
        %tmp.71 = lgetv %i;
        symbol [ i %tmp.71 197 20 21 ];
        %tmp.72 = 0;
        symbol [ B_N %tmp.74 197 26 29 ];
        %tmp.74 = getv ? :B_N;
        %tmp.75 = 1;
