        %a.1 = local;
        symbol [ a %a.1 304 12 13 ];
        %tmp.1 = newa 20;
        %tmp.2 = "Black bread of the shallow seams. Burns hot, pays little, always there.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "A creature pressed flat by a hundred million winters of rock.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Bright enough to make a whole shift stop and stare at one hand.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "It grew in a hollow with no light, and still came out shining.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "It fell before there was a mine here. It was waiting for you.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "Some miner cut this handle by fire. His seam is still on the map.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "The hardest thing anyone here has ever held. It cuts the cutters.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Gears the size of doors, half swallowed by stone, still faintly warm.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "Not made by the camp. Not made by anyone the camp knows about.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        %tmp.29 = "Gold poured into bone. Somebody down here was worshipped, or feared.";
        %tmp.30 = dup %tmp.28;
        %tmp.31 = aputv %tmp.30 9 %tmp.29;
        %tmp.32 = "It ticks. Bring it near the Laboratory and the instruments panic.";
        %tmp.33 = dup %tmp.31;
        %tmp.34 = aputv %tmp.33 10 %tmp.32;
        %tmp.35 = "It answers questions nobody asked and hums the same note as the Abyss.";
        %tmp.36 = dup %tmp.34;
        %tmp.37 = aputv %tmp.36 11 %tmp.35;
        %tmp.38 = "A pocket of the world's furnace, cooled just enough to carry.";
        %tmp.39 = dup %tmp.37;
        %tmp.40 = aputv %tmp.39 12 %tmp.38;
        %tmp.41 = "Carved from frozen lava, faceless, and heavier than it should be.";
        %tmp.42 = dup %tmp.40;
        %tmp.43 = aputv %tmp.42 13 %tmp.41;
        %tmp.44 = "A piece of the gap between the layers. Light goes in and does not leave.";
        %tmp.45 = dup %tmp.43;
        %tmp.46 = aputv %tmp.45 14 %tmp.44;
        %tmp.47 = "Warm, patient, and slowly cracking. Whatever is inside is not finished.";
        %tmp.48 = dup %tmp.46;
        %tmp.49 = aputv %tmp.48 15 %tmp.47;
        %tmp.50 = "One rib of something that walked when the mountains were young.";
        %tmp.51 = dup %tmp.49;
        %tmp.52 = aputv %tmp.51 16 %tmp.50;
        %tmp.53 = "It still remembers the sky it fell out of and glows when you sleep.";
        %tmp.54 = dup %tmp.52;
        %tmp.55 = aputv %tmp.54 17 %tmp.53;
        %tmp.56 = "Hold it and yesterday's shift feels like it happened twice.";
        %tmp.57 = dup %tmp.55;
        %tmp.58 = aputv %tmp.57 18 %tmp.56;
        %tmp.59 = "The bottom of the mine holds a seed. Every world above grew out of one.";
        %tmp.60 = dup %tmp.58;
        %tmp.61 = aputv %tmp.60 19 %tmp.59;
        lputv %a.1 %tmp.61;
        symbol [ a %a.1 304 12 13 ];
