    [ @file = "/Users/kkorolczuk/work/garmin/mines/source/MnConst.mc"; @line = 143; @symbol_functiondef = [bLore,143,13,18]; @symbol_param<0> = [i,143,19,20]; ]
    function bLore(i) {
