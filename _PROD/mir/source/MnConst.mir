        %a.1 = local;
        symbol [ a %a.1 207 12 13 ];
        %tmp.1 = newa 9;
        %tmp.2 = "Splintered handle, chipped head. It still opened this whole mine.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Forge-hammered and balanced. Iron bites where wood only bruised.";
