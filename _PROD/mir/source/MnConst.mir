        %a.1 = local;
        symbol [ a %a.1 144 12 13 ];
        %tmp.1 = newa 9;
        %tmp.2 = "The first hole your grandfather sank. Every metre below starts here.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Coal-fired and never cold. Bad ore goes in, clean metal comes out.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "A rattling cage on frayed cable. It turns a long climb into a short drop.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "Bunks, stew and lanterns. Rested miners swing harder for longer.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "Chalkboards full of rock maths. Someone finally read the geology.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
        %tmp.17 = "Cutting wheels sing all night. Rough stones leave here as jewels.";
        %tmp.18 = dup %tmp.16;
        %tmp.19 = aputv %tmp.18 5 %tmp.17;
        %tmp.20 = "It listens to the rock and paints what it hears on a cracked screen.";
        %tmp.21 = dup %tmp.19;
        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "Pistons thicker than a man. It holds the deep dark open by force.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "Nobody at the camp understands it. It simply eats the stone away.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        lputv %a.1 %tmp.28;
        symbol [ a %a.1 144 12 13 ];
[ "/Users/kkorolczuk/work/garmin/mines/source/MnConst.mc" 155 8 ]
