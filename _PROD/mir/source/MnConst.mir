        %a.1 = local;
        symbol [ a %a.1 368 12 13 ];
        %tmp.1 = newa 12;
        %tmp.2 = "A cavern roofed in blue spines. The lamps were barely needed.";
        %tmp.3 = dup %tmp.1;
        %tmp.4 = aputv %tmp.3 0 %tmp.2;
        %tmp.5 = "Cut steps, a doorway, and dust that nobody in camp had walked in.";
        %tmp.6 = dup %tmp.4;
        %tmp.7 = aputv %tmp.6 1 %tmp.5;
        %tmp.8 = "Sealed from the inside. Whatever locked it wanted to stay in.";
        %tmp.9 = dup %tmp.7;
        %tmp.10 = aputv %tmp.9 2 %tmp.8;
        %tmp.11 = "A repeating pulse from below. It got louder the deeper we went.";
        %tmp.12 = dup %tmp.10;
        %tmp.13 = aputv %tmp.12 3 %tmp.11;
        %tmp.14 = "The floor simply stops. Dropped stones are never heard landing.";
        %tmp.15 = dup %tmp.13;
        %tmp.16 = aputv %tmp.15 4 %tmp.14;
