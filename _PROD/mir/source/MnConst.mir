        %tmp.22 = aputv %tmp.21 6 %tmp.20;
        %tmp.23 = "It opens a seam in the dark itself. Miners look away when it fires.";
        %tmp.24 = dup %tmp.22;
        %tmp.25 = aputv %tmp.24 7 %tmp.23;
        %tmp.26 = "The mountain remembers this tool. That is why the mountain moves.";
        %tmp.27 = dup %tmp.25;
        %tmp.28 = aputv %tmp.27 8 %tmp.26;
        lputv %a.1 %tmp.28;
        symbol [ a %a.1 207 12 13 ];
